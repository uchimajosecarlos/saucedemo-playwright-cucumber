# Copiar como .env y ajustar. Todas las variables son opcionales.
BASE_URL=https://www.saucedemo.com
# chromium | firefox | webkit
BROWSER=chromium
# false = ver el navegador
HEADLESS=true
# Pausa entre acciones en milisegundos (0 = sin pausa); útil junto con HEADLESS=false
SLOW_MO=0
# Timeout de acciones y aserciones, en milisegundos
DEFAULT_TIMEOUT=15000
# Traces de Playwright: retain-on-failure (solo fallos) | on (siempre) | off
TRACE=retain-on-failure
# Contraseña de los usuarios de prueba (publicada por Sauce Demo)
SAUCE_PASSWORD=secret_sauce
